generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id        String   @id @default(cuid())
  title     String
  itemCount Int
  totalValueKes Int
  date      String
  status    String
  imageUrl  String?
  items     Item[]
  steps     AgentStep[]
}

model AgentStep {
  id         String @id @default(cuid())
  scanId     String
  scan       Scan   @relation(fields: [scanId], references: [id])
  key        String
  status     String
  summary    String?
}

model Item {
  id              String @id @default(cuid())
  scanId          String
  scan            Scan   @relation(fields: [scanId], references: [id])
  name            String
  unit            String
  category        String
  quantity        Int
  expectedQuantity Int
  condition       String
  unitPriceKes    Int
  confidence      Int
  confirmed       Boolean
  suggestedAction String
  actionReason    String
  colorHex        String
  imageUrl       String?
}

model StoreListing {
  id           String @id @default(cuid())
  shopId       String
  scanId       String?
  name         String
  unit         String
  category     String
  quantity     Int
  unitPriceKes Int
  imageUrl     String?
  createdAt    DateTime @default(now())
}

model Payment {
  id                String @id @default(cuid())
  checkoutRequestId String @unique
  phone             String
  amount            Int
  status            String
  createdAt         DateTime @default(now())
}

model SaleRecord {
  id        String @id @default(cuid())
  scanId    String?
  itemName  String
  quantity  Int
  createdAt DateTime @default(now())
}
